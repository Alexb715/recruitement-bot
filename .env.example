# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Channel where completed interview embeds are posted
RESULTS_CHANNEL_ID=000000000000000000

# Role pinged when a new application is submitted
RECRUITER_ROLE_ID=000000000000000000

# Optional: channel where the persistent "Apply Here" button should live.
# When set, the bot auto-posts the button there on startup and reuses the
# same message across restarts. Leave blank to disable auto-posting (you can
# still use the /post-apply-message command manually).
APPLY_CHANNEL_ID=

# Optional: channel where the persistent FAQ message should live. When set, the
# bot auto-posts the FAQ embed there on startup and reuses the same message
# across restarts. Leave blank to disable auto-posting (you can still use the
# /post-faq command manually).
FAQ_CHANNEL_ID=

# Optional: channel where the persistent Requirements message should live. Same
# auto-post + reuse behavior as FAQ_CHANNEL_ID. Leave blank to use
# /post-requirements manually instead.
REQUIREMENTS_CHANNEL_ID=

# Optional: channel/role IDs rendered as clickable mentions inside the FAQ text.
# Leave any blank to fall back to plain-text wording for that reference.
FAQ_INTERVIEW_REQUEST_CHANNEL_ID=
FAQ_RULES_CHANNEL_ID=
FAQ_OPP_RECRUITMENT_CHANNEL_ID=
FAQ_SUPPORT_ROLE_ID=

# Optional: Help / Ticket button. When TICKET_CATEGORY_ID is set, the
# "Help / Inquiry" button on the apply message opens a private ticket channel
# under that category, visible only to the member and FAQ_SUPPORT_ROLE_ID (which
# is also pinged). Closing a ticket moves it to TICKET_CLOSED_CATEGORY_ID and
# revokes the opener's access. The bot needs the Manage Channels and Manage Roles
# permissions. Leave TICKET_CATEGORY_ID blank to disable the button.
TICKET_CATEGORY_ID=
TICKET_CLOSED_CATEGORY_ID=

# Optional: guild ID for instant slash-command sync during development.
# Leave blank for global sync (can take up to 1 hour to propagate).
DEV_GUILD_ID=

# Optional: recurring prospect-ping schedule (only used when prospect management
# is enabled with a PROSPECT_PING_CHANNEL_ID). The nudge fires at these fixed
# daily clock times in the given IANA timezone (DST-aware). The defaults shown
# are 9 AM and 9 PM Eastern.
PROSPECT_PING_TIMES=09:00,21:00
PROSPECT_PING_TIMEZONE=America/Toronto

# Optional: community-server invites for accepted applicants. The bot creates a
# single-use invite to each channel and DMs it on accept (the OPP server invite
# only goes to OPP applicants). The main server is identified by the guild that
# owns MAIN_SERVER_INVITE_CHANNEL_ID. Requires Create Instant Invite.
MAIN_SERVER_INVITE_CHANNEL_ID=
OPP_SERVER_INVITE_CHANNEL_ID=

# Optional: roles granted in the main server when an accepted applicant joins
# it. ACCESS goes to every accepted applicant; each department role goes only to
# applicants who picked that department. Leave any blank to skip it. If the main
# server uses rules screening, roles are granted once the member accepts the
# rules. Requires Manage Roles in the main server, with the bot's role ABOVE all
# of these roles in the role list.
MAIN_SERVER_ACCESS_ROLE_ID=
MAIN_SERVER_OPP_ROLE_ID=664231740835102730
MAIN_SERVER_FIRE_EMS_ROLE_ID=595292651092312070
MAIN_SERVER_COMMS_ROLE_ID=947590232465895516
MAIN_SERVER_CIVILIAN_ROLE_ID=592782103632937005

# Optional: recruitment-server graduation. When enabled (default true), accepted
# applicants are kicked from the recruitment server once they join a community
# server (main/OPP) or after RECRUITMENT_GRADUATION_DAYS pass since acceptance,
# whichever comes first. Their acceptance invites also expire after that many
# days, so an unused invite becomes null and void. Requires the bot to have Kick
# Members in the recruitment server. Set ENABLED=false to disable the kick
# (invites still expire). Discord caps invite expiry at 7 days.
RECRUITMENT_GRADUATION_ENABLED=true
RECRUITMENT_GRADUATION_DAYS=5

# Optional: the bot's presence shown under its name. TYPE is one of
# playing / watching / listening / competing (default watching); TEXT is the
# activity text. Together they read as e.g. "Watching for new applicants".
BOT_ACTIVITY_TYPE=watching
BOT_ACTIVITY_TEXT=for new applicants

# Path to the SQLite database file (relative to project root)
DB_PATH=data/applications.db
